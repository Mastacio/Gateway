{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Cors":{
   "Origins":[
     "http://localhost:3000"
     ]
  },
  
 
  "Jwt": {
    "Issuer": "Issuer",
    "Audience": "Audience",
    "Key": "Key"
  },

  "PublicRoutes": [
    "/security/authentication",
    "/security/swagger"
  ],
  
  "ReverseProxy": {
    "Routes": {
      "security-swagger": {
        "ClusterId": "securityCluster",
        "Match": {
          "Path": "/security/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/security"
          }
        ]
      },
      "security": {
        "ClusterId": "securityCluster",
        "Match": {
          "Path": "/security/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/security"
          }
        ]
      }
    },
    "Clusters": {
      "securityCluster": {
        "Destinations": {
          "security": {
            "Address": "http://localhost:4000/"
          }
        }
      }
    }
  }
}

